# Local development: a Postgres running on your machine.
DATABASE_URL="postgresql://postgres@localhost:5432/bulk_buying"

# Production: the pooled connection string from your Neon project.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Password for /admin. Set a real one before deploying.
ADMIN_PASSWORD="change-me"

# Optional. Set either one to show a contact link in the footer.
